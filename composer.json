{
	"name": "nette/code-checker",
	"description": "✅ Nette Code Checker: finds and fixes formal errors in PHP, Latte, NEON, JSON and YAML files, such as encoding, line endings, indentation and trailing whitespace.",
	"keywords": ["nette", "code checker", "linter", "lint", "code quality", "latte", "neon"],
	"homepage": "https://doc.nette.org/tools/code-checker",
	"type": "project",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": ">= 8.0",
		"nette/command-line": "^1.9.2",
		"nette/utils": "^4.0",
		"nette/neon": "^3.0",
		"latte/latte": "^3.0.7",
		"nette/forms": "^3.0",
		"nette/caching": "^3.1",
		"nette/application": "^3.1",
		"nette/assets": "^1.0"
	},
	"require-dev": {
		"nette/tester": "^2.0",
		"tracy/tracy": "^2.6",
		"phpstan/phpstan": "^2.2",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"bin": ["code-checker"],
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "3.3-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
